# Doxyfile Configuration Template

# --- Project Info ---
PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "A modern C++ interface to the FFTW3 library"
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"

# --- Output ---
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/doxygen"
CREATE_SUBDIRS         = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.md"

# --- Input ---
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/FFTWpp/src" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs"
EXCLUDE                = "@CMAKE_CURRENT_SOURCE_DIR@/docs/fftwpp-plan.md"

RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# --- Diagnostics ---
QUIET                  = YES
WARN_AS_ERROR          = NO

# --- Graphics (optional, but recommended) ---
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES